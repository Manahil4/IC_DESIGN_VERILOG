`timescale 1ns/1ps

module reg32_tb;

    reg clk;
    reg reset;
    reg load;
    reg [31:0] d;
    wire [31:0] q;

    reg [31:0] q_prev;

    // DUT
    reg32 dut (
        .clk(clk),
        .reset(reset),
        .load(load),
        .d(d),
        .q(q)
    );

    // Clock
    always #5 clk = ~clk;

    // Capture previous q
    always @(posedge clk) begin
        q_prev <= q;
    end

    // Assertions (IMMEDIATE)
    always @(posedge clk) begin

        // Reset behavior
        if (reset) begin
            assert (q == 32'b0)
            else $error("RESET FAILED: q != 0");
        end

        // Load behavior
        if (!reset && load) begin
            assert (q == d)
            else $error("LOAD FAILED: q != d");
        end

        // Hold behavior
        if (!reset && !load) begin
            assert (q == q_prev)
            else $error("HOLD FAILED: q changed");
        end

    end

    // Stimulus
    initial begin
        clk = 0;
        reset = 1;
        load = 0;
        d = 0;

        #10 reset = 0;

        #10 load = 1; d = 32'h1234_ABCD;
        #10 load = 0;

        #10 d = 32'hFFFF_0000;

        #20 $finish;
    end

endmodule
